# One YouCam product API is integrated for live image previews: Hair Transfer v2.1.
# mock uses saved sample previews and spends 0 units; live calls YouCam (2 units per render).
YOUCAM_MODE=mock
YOUCAM_API_KEY=
# Optional: only enable the access-code gate for a private live deployment.
# Public demos are ungated by default; live renders use available units, subject to the daily cap and rate limit.
AHEAD_REQUIRE_TESTER_CODE=false
TESTER_CODE=
# Optional balance holdback; leave at 0 for recording live try-ons.
AHEAD_RESERVE_UNITS=0
